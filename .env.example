# Admin login and session signing
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional storage overrides. Leave unset for local development defaults:
# data/ and uploads/ relative to the project root.
# On Render, point both at directories inside the persistent disk mount.
VELTRIX_DATA_DIR=
VELTRIX_UPLOAD_DIR=
